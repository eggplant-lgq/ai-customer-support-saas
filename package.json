{
  "name": "ai-customer-support-saas-workspace",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.8.1",
  "scripts": {
    "dev": "pnpm --filter @ai-cs/web dev",
    "build": "pnpm --filter @ai-cs/web build",
    "lint": "pnpm --filter @ai-cs/web lint",
    "db:generate": "pnpm --filter @ai-cs/db db:generate",
    "db:migrate": "pnpm --filter @ai-cs/db db:migrate",
    "db:studio": "pnpm --filter @ai-cs/db db:studio",
    "check": "pnpm lint && pnpm build"
  }
}
